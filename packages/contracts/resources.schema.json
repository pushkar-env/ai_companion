    "Companion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "definition_id": {
          "type": "string",
          "format": "uuid"
        },
        "definition_version": {
          "type": "integer",
          "minimum": 0
