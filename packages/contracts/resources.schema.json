    "Traits": {
      "type": "object",
      "properties": {
        "warmth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "humor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "energy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "curiosity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "directness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "warmth",
        "humor",
        "energy",
        "curiosity",
        "directness"
      ],
      "additionalProperties": false
    },
    "UserProfile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
