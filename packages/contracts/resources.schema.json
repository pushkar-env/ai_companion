        "rig_family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "loadout_version": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "version",
        "created_at",
        "updated_at",
        "definition_id",
        "definition_version",
        "name",
        "pronouns",
        "traits",
        "voice_profile_id",
        "rig_family",
        "loadout_version"
      ]
    },
    "Conversation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "companion_id": {
          "type": "string",
          "format": "uuid"
