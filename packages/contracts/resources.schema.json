        "pronouns": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "traits": {
          "$ref": "#/$defs/Traits"
        },
        "voice_profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
