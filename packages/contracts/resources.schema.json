        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "detail": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "trace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "retryable": {
          "type": "boolean"
        },
        "field_errors": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 0,
            "maxLength": 300
          }
        }
      },
      "required": [
        "type",
        "title",
        "status",
        "code",
        "detail",
        "trace_id",
        "retryable",
        "field_errors"
      ]
